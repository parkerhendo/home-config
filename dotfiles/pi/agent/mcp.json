{
  "mcpServers": {
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@latest"
      ],
      "directTools": true
    },
    "notion": {
      "url": "https://mcp.notion.com/mcp",
      "directTools": true
    },
    "sentry": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote@latest",
        "https://mcp.sentry.dev/mcp"
      ],
      "directTools": false
    },
    "vercel": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote",
        "https://mcp.vercel.com"
      ],
      "directTools": false
    },
    "braintrust": {
      "url": "http://127.0.0.1:8000/mcp",
      "auth": "oauth",
      "directTools": false
    },
    "datadog": {
      "url": "https://mcp.us5.datadoghq.com/api/unstable/mcp-server/mcp",
      "directTools": false
    }
  }
}
