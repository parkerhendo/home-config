{
  "mcpServers": {
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@latest"
      ],
      "exposure": "direct"
    },
    "paper": {
      "command": "/Applications/Paper.app/Contents/Resources/app.asar.unpacked/dist/cli-bin/darwin-arm64/paper",
      "args": ["mcp"],
      "exposure": "codemode"
    },
    "notion": {
      "url": "https://mcp.notion.com/mcp",
      "exposure": "direct"
    },
    "sentry": {
      "url": "https://mcp.sentry.dev/mcp",
      "exposure": "codemode"
    },
    "vercel": {
      "url": "https://mcp.vercel.com",
      "exposure": "codemode"
    },
    "braintrust": {
      "url": "http://127.0.0.1:8000/mcp",
      "exposure": "codemode"
    },
    "braintrust-prod": {
      "url": "https://api.braintrust.dev/mcp",
      "exposure": "codemode"
    },
    "datadog": {
      "url": "https://mcp.us5.datadoghq.com/api/unstable/mcp-server/mcp",
      "exposure": "codemode"
    }
  }
}
